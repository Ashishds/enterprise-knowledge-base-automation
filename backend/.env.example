# ------------------------------------------------------------------------------
# Euri AI Gateway Credentials & Model Configurations
# ------------------------------------------------------------------------------
EURI_API_KEY=
EURI_BASE_URL=https://api.euron.one/api/v1/euri
EURI_GENERATION_MODEL=gpt-4.1
EURI_PLANNER_MODEL=gpt-4.1-mini
EURI_FALLBACK_MODEL=gpt-4.1-mini
EURI_EMBEDDING_MODEL=gemini-embedding-2-preview
EURI_EMBEDDING_DIMENSIONS=1536

# ------------------------------------------------------------------------------
# Qdrant Vector Store (Local Docker or Qdrant Cloud Cluster)
# ------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# Supabase / Managed PostgreSQL (Relational DB & Audit Store)
# Get credentials from your Supabase Project Settings -> Database & API
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ekba
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# Redis Cache & Token Bucket Rate Limiter
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# AWS S3 Storage & AWS Cognito Auth
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_DOCUMENTS=ekba-documents-local
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# ------------------------------------------------------------------------------
# LangSmith Tracing & Observability (Optional)
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ekba-local

# ------------------------------------------------------------------------------
# Application Runtime Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=15728640
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150
RETRIEVAL_TOP_K=6
MIN_SIMILARITY_FOR_ANSWER=0.15
